# Normalise to LF in the repository and the working tree (Spotless and Checkstyle expect LF).
* text=auto eol=lf

# Windows scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Unix scripts must stay LF so they run in Docker and on Linux CI.
mvnw text eol=lf
*.sh text eol=lf

*.jar binary
*.png binary
*.jpg binary
